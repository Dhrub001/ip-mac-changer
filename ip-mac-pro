CYAN="\033[0;36m"; PURPLE="\033[0;35m"; BLUE="\033[0;34m"
BOLD="\033[1m"; NC="\033[0m"

# Global variables
INTERFACE=""
ORIGINAL_MAC=""
ORIGINAL_IP=""
MODE_CHOICE=""

