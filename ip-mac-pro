# Stop all services and restore network
stop_all() {
    echo -e "\n${YELLOW}[!] STOPPING all services and restoring network...${NC}"
    
    # Kill any running instances
    pkill -f "ip-mac-pro" 2>/dev/null
    
    # Restore original MAC
    if [ -n "$ORIGINAL_MAC" ] && [ -n "$INTERFACE" ]; then
        ip link set dev $INTERFACE down 2>/dev/null
        ip link set dev $INTERFACE address $ORIGINAL_MAC 2>/dev/null
        ip link set dev $INTERFACE up 2>/dev/null
        echo -e "${GREEN}[✓] Original MAC restored: $ORIGINAL_MAC${NC}"
    fi
    
    # Restore IP via DHCP
    dhclient -r $INTERFACE 2>/dev/null
    dhclient $INTERFACE 2>/dev/null
    
    # Stop and mask Tor completely
    systemctl stop tor 2>/dev/null
    systemctl disable tor 2>/dev/null
    systemctl mask tor 2>/dev/null
    
    # Kill Tor processes
    pkill -f tor 2>/dev/null
    
    # Clear iptables rules
    iptables -F 2>/dev/null
    iptables -t nat -F 2>/dev/null
    
    # Restart network
    systemctl restart NetworkManager 2>/dev/null
    
    echo -e "${GREEN}[✓] Tor stopped and disabled${NC}"
    echo -e "${GREEN}[✓] Network restored to normal${NC}"
    echo -e "${RED}[✗] All anonymization services STOPPED${NC}"
    exit 0
}

# Setup Tor for location changing
setup_tor() {
    echo -e "${CYAN}[→] Setting up Tor for location changing...${NC}"
    
    # Stop existing Tor first
    systemctl stop tor 2>/dev/null
    pkill -f tor 2>/dev/null
    
    # Unmask and start Tor
    systemctl unmask tor 2>/dev/null
    systemctl start tor 2>/dev/null
    
    # Wait for Tor to be ready
    for i in {1..15}; do
        if curl --socks5-hostname localhost:9050 -s --max-time 2 https://check.torproject.org/ > /dev/null 2>&1; then
            echo -e "${GREEN}[✓] Tor is ready${NC}"
            return 0
        fi
        echo -n "."
        sleep 1
    done
    echo -e "\n${YELLOW}[!] Tor may still be bootstrapping...${NC}"
}

# Get current location via Tor
get_location() {
    local location=$(curl --socks5-hostname localhost:9050 -s --max-time 5 "http://ip-api.com/line/?fields=country,city" 2>/dev/null | head -2 | tr '\n' ' ')
    if [ -n "$location" ]; then
        echo "$location"
    else
        echo "Unknown"
    fi
}

# Change Tor location (new exit node)
change_location() {
    echo -e "${CYAN}[→] Changing location (Tor circuit)...${NC}"
    echo -e 'AUTHENTICATE ""\r\nSIGNAL NEWNYM\r\nQUIT' | nc -w 2 127.0.0.1 9051 2>/dev/null
    sleep 3
    
    NEW_LOC=$(get_location)
    echo -e "${GREEN}[✓] New location: ${NEW_LOC}${NC}"
}

# Change MAC address
change_mac() {
    NEW_MAC=$(printf "02:%02x:%02x:%02x:%02x:%02x" $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
    echo -e "${CYAN}[→] Changing MAC address...${NC}"
    ip link set dev $INTERFACE down 2>/dev/null
    ip link set dev $INTERFACE address $NEW_MAC 2>/dev/null
    ip link set dev $INTERFACE up 2>/dev/null
    sleep 1
    if [ "$(cat /sys/class/net/$INTERFACE/address 2>/dev/null)" = "$NEW_MAC" ]; then
        echo -e "${GREEN}[✓] MAC changed: ${NEW_MAC}${NC}"
        return 0
    else
        echo -e "${RED}[✗] MAC change failed!${NC}"
        return 1
    fi
}

# Change IP address
change_ip() {
    echo -e "${CYAN}[→] Renewing IP address...${NC}"
    dhclient -r $INTERFACE 2>/dev/null
    sleep 1
    dhclient $INTERFACE 2>/dev/null
    sleep 2
    CURRENT_IP=$(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
    if [ -n "$CURRENT_IP" ]; then
        echo -e "${GREEN}[✓] New IP: ${CURRENT_IP}${NC}"
        return 0
    else
        echo -e "${YELLOW}[!] IP unchanged${NC}"
        return 1
    fi
}

# One-shot mode
one_shot() {
    echo -e "${BLUE}[*] One Shot Mode - Changing once${NC}"
    change_mac
    change_ip
    
    if [[ "$MODE_CHOICE" == "1" ]] || [[ "$MODE_CHOICE" == "3" ]]; then
        setup_tor
        change_location
    fi
    
    echo -e "\n${GREEN}[✓] Changes applied!${NC}"
    echo -e "New MAC: $(cat /sys/class/net/$INTERFACE/address)"
    echo -e "New IP: $(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)"
    
    echo -e "\n${YELLOW}[?] Services still running. Run 'sudo ./ip-mac-pro --stop' to stop all${NC}"
    exit 0
}

# Continuous mode loop
continuous_mode() {
    local INTERVAL=$1
    local COUNTER=0
    
    while true; do
        COUNTER=$((COUNTER + 1))
        echo ""
        echo -e "${PURPLE}════════════════════════════════════════════${NC}"
        echo -e "${BOLD}${CYAN}[🌀] CHANGE CYCLE #${COUNTER}${NC}"
        echo -e "${PURPLE}════════════════════════════════════════════${NC}"
        
        # Change MAC and IP
        if [[ "$MODE_CHOICE" == "1" ]] || [[ "$MODE_CHOICE" == "2" ]]; then
            change_mac
            sleep 1
            change_ip
        fi
        
        # Change location if requested
        if [[ "$MODE_CHOICE" == "1" ]] || [[ "$MODE_CHOICE" == "3" ]]; then
            if [ "$COUNTER" -eq 1 ]; then
                setup_tor
            fi
            change_location
        fi
        
        # Show current status
        echo ""
        echo -e "${BLUE}📡 Current Status:${NC}"
        echo -e "   MAC: ${GREEN}$(cat /sys/class/net/$INTERFACE/address 2>/dev/null)${NC}"
        CURRENT_IP=$(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
        echo -e "   IP:  ${GREEN}${CURRENT_IP:-No IP assigned}${NC}"
        
        if [[ "$MODE_CHOICE" == "1" ]] || [[ "$MODE_CHOICE" == "3" ]]; then
            echo -e "   Location: ${GREEN}$(get_location)${NC}"
        fi
        
        echo -e "\n${YELLOW}[⏰] Next change in ${INTERVAL} seconds...${NC}"
        echo -e "${YELLOW}[!] Press Ctrl+C or run './ip-mac-pro --stop' to stop${NC}"
        
        sleep $INTERVAL
    done
}

# Main menu
main_menu() {
    show_banner
    
    # Detect interface
    INTERFACE=$(ip route | grep default | awk '{print $5}' | head -1)
    [ -z "$INTERFACE" ] && INTERFACE=$(ip link show | grep -v lo | grep "state UP" | head -1 | cut -d: -f2 | xargs)
    
    ORIGINAL_MAC=$(cat /sys/class/net/$INTERFACE/address 2>/dev/null)
    ORIGINAL_IP=$(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
    
    echo -e "${CYAN}[i] Interface: ${GREEN}$INTERFACE${NC}"
    echo -e "${CYAN}[i] Original MAC: ${GREEN}$ORIGINAL_MAC${NC}"
    echo -e "${CYAN}[i] Original IP: ${GREEN}$ORIGINAL_IP${NC}"
    echo ""
    
    # Mode selection
    echo -e "${YELLOW}╔════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║              SELECT OPERATION MODE                     ║${NC}"
    echo -e "${YELLOW}╚════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}    1) ${GREEN}Full Anonymizer${NC}     - Change IP, MAC & Location (Tor)"
    echo -e "${CYAN}    2) ${GREEN}IP & MAC Only${NC}        - Just change IP and MAC"
    echo -e "${CYAN}    3) ${GREEN}Location Only${NC}        - Just change Tor exit node"
    echo -e "${CYAN}    4) ${GREEN}One Shot${NC}             - Change once and exit"
    echo -e "${CYAN}    5) ${RED}STOP ALL${NC}               - Stop all services and restore network"
    echo ""
    
    read -p "$(echo -e ${CYAN}[?] Enter your choice [1-5]: ${NC})" MODE_CHOICE
    
    # Handle stop option
    if [[ "$MODE_CHOICE" == "5" ]]; then
        stop_all
    fi
    
    # Interval selection (for continuous mode)
    if [[ "$MODE_CHOICE" != "4" ]] && [[ "$MODE_CHOICE" != "5" ]]; then
        echo ""
        echo -e "${YELLOW}╔════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║              SELECT CHANGE INTERVAL                    ║${NC}"
        echo -e "${YELLOW}╚════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${CYAN}    1) ${GREEN}30 seconds${NC}  - Fast Mode"
        echo -e "${CYAN}    2) ${GREEN}60 seconds${NC}  - Normal Mode ${YELLOW}(Recommended)${NC}"
        echo -e "${CYAN}    3) ${GREEN}300 seconds${NC} - Stealth Mode (5 minutes)"
        echo -e "${CYAN}    4) ${GREEN}Custom${NC}      - Enter your own value"
        echo ""
        
        read -p "$(echo -e ${CYAN}[?] Enter your choice [1-4]: ${NC})" INT_CHOICE
        
        case $INT_CHOICE in
            1) INTERVAL=30; MODE_DESC="Fast Mode (30 seconds)" ;;
            2) INTERVAL=60; MODE_DESC="Normal Mode (60 seconds)" ;;
            3) INTERVAL=300; MODE_DESC="Stealth Mode (5 minutes)" ;;
            4) read -p "$(echo -e ${CYAN}[?] Enter custom seconds: ${NC})" INTERVAL
               [[ ! "$INTERVAL" =~ ^[0-9]+$ ]] || [ "$INTERVAL" -lt 10 ] && INTERVAL=60
               MODE_DESC="Custom (${INTERVAL} seconds)" ;;
            *) INTERVAL=60; MODE_DESC="Normal Mode (60 seconds)" ;;
        esac
    fi
    
    # Execute based on mode
    case $MODE_CHOICE in
        1)  echo -e "${GREEN}[✓] Mode: Full Anonymizer (IP + MAC + Location)${NC}"
            echo -e "${GREEN}[✓] Interval: ${MODE_DESC}${NC}"
            sleep 2
            continuous_mode $INTERVAL
            ;;
        2)  echo -e "${GREEN}[✓] Mode: IP & MAC Only${NC}"
            echo -e "${GREEN}[✓] Interval: ${MODE_DESC}${NC}"
            sleep 2
            continuous_mode $INTERVAL
            ;;
        3)  echo -e "${GREEN}[✓] Mode: Location Only (Tor)${NC}"
            echo -e "${GREEN}[✓] Interval: ${MODE_DESC}${NC}"
            sleep 2
            continuous_mode $INTERVAL
            ;;
        4)  one_shot
            ;;
        5)  stop_all
            ;;
        *)  echo -e "${RED}[!] Invalid choice${NC}"
            exit 1
            ;;
    esac
}

# Handle command line arguments
if [[ "$1" == "--stop" ]] || [[ "$1" == "-s" ]]; then
    # Need to detect interface and original MAC first
    INTERFACE=$(ip route | grep default | awk '{print $5}' | head -1)
    ORIGINAL_MAC=$(cat /sys/class/net/$INTERFACE/address 2>/dev/null)
    stop_all
else
    # Normal mode - show menu
    main_menu
fi
