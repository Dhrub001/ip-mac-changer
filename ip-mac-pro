RED="\033[0;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"
CYAN="\033[0;36m"; PURPLE="\033[0;35m"; BLUE="\033[0;34m"
BOLD="\033[1m"; NC="\033[0m"

INTERFACE=""
ORIGINAL_MAC=""
ORIGINAL_IP=""
MODE_CHOICE=""

show_banner() {
    clear
    echo -e "${PURPLE}"
    echo "╔═══════════════════════════════════════════════════════════╗"
    echo "║                                                           ║"
    echo "║   ██▓ ██▓███   ▄▄▄      ▄▄▄█████▓ ▄████▄   ██░ ██ ▄▄▄     ║"
    echo "║  ▓██▒▓██░  ██▒▒████▄    ▓  ██▒ ▓▒▒██▀ ▀█  ▓██░ ██▒████▄   ║"
    echo "║  ▒██▒▓██░ ██▓▒▒██  ▀█▄  ▒ ▓██░ ▒░▒▓█    ▄ ▒██▀▀██░▒██  ▀█▄ ║"
    echo "║  ░██░▒██▄█▓▒ ▒░██▄▄▄▄██ ░ ▓██▓ ░ ▒▓▓▄ ▄██▒░▓█ ░██ ░██▄▄▄▄██║"
    echo "║  ░██░▒██▒ ░  ░ ▓█   ▓██▒  ▒██▒ ░ ▒ ▓███▀ ░░▓█▒░██▓ ▓█   ▓██║"
    echo "║  ░▓  ▒▓▒░ ░  ░ ▒▒   ▓▒█░  ▒ ░░   ░ ░▒ ▒  ░ ▒ ░░▒░▒ ▒▒   ▓▒█║"
    echo "║   ▒ ░░▒ ░       ▒   ▒▒ ░    ░      ░  ▒    ▒ ░▒░ ░  ▒   ▒▒ ░║"
    echo "║   ▒ ░░░         ░   ▒     ░      ░         ░  ░░ ░  ░   ▒   ║"
    echo "║   ░                 ░  ░            ░ ░       ░  ░       ░ 3║"
    echo "║                                                           ║"
    echo "║    IP, MAC & LOCATION CHANGER v2.0                       ║"
    echo "║         Author: Dhrub Raj Giri (DRG)                     ║"
    echo "║        \"DISAPPEAR WITHOUT A TRACE\"                       ║"
    echo "╚═══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    sleep 2
}

stop_all() {
    echo -e "\n${YELLOW}[!] Stopping services and restoring network...${NC}"
    
    if [ -n "$ORIGINAL_MAC" ] && [ -n "$INTERFACE" ]; then
        ip link set dev $INTERFACE down 2>/dev/null
        ip link set dev $INTERFACE address $ORIGINAL_MAC 2>/dev/null
        ip link set dev $INTERFACE up 2>/dev/null
        echo -e "${GREEN}[✓] MAC restored to: $ORIGINAL_MAC${NC}"
    fi
    
    dhclient -r $INTERFACE 2>/dev/null
    dhclient $INTERFACE 2>/dev/null
    
    systemctl unmask tor 2>/dev/null
    systemctl stop tor 2>/dev/null
    systemctl disable tor 2>/dev/null
    
    pkill -f tor 2>/dev/null
    
    systemctl restart NetworkManager 2>/dev/null
    
    echo -e "${GREEN}[✓] Tor stopped and disabled${NC}"
    echo -e "${GREEN}[✓] Network restored to normal${NC}"
    echo -e "${RED}[✗] All services STOPPED${NC}"
    exit 0
}

setup_tor() {
    echo -e "${CYAN}[→] Starting Tor...${NC}"
    systemctl unmask tor 2>/dev/null
    systemctl start tor 2>/dev/null
    sleep 3
}

change_location() {
    echo -e "${CYAN}[→] Changing location...${NC}"
    echo -e 'AUTHENTICATE ""\r\nSIGNAL NEWNYM\r\nQUIT' | nc -w 2 127.0.0.1 9051 2>/dev/null
    sleep 2
    echo -e "${GREEN}[✓] Location changed${NC}"
}

change_mac() {
    NEW_MAC=$(printf "02:%02x:%02x:%02x:%02x:%02x" $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
    echo -e "${CYAN}[→] Changing MAC...${NC}"
    ip link set dev $INTERFACE down 2>/dev/null
    ip link set dev $INTERFACE address $NEW_MAC 2>/dev/null
    ip link set dev $INTERFACE up 2>/dev/null
    sleep 1
    echo -e "${GREEN}[✓] MAC changed to: $NEW_MAC${NC}"
}

change_ip() {
    echo -e "${CYAN}[→] Renewing IP...${NC}"
    
    dhclient -r $INTERFACE 2>/dev/null
    sleep 2
    
    ip addr flush $INTERFACE 2>/dev/null
    sleep 1
    
    dhclient -1 -v $INTERFACE 2>/dev/null
    sleep 3
    
    CURRENT_IP=$(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
    
    if [ -z "$CURRENT_IP" ]; then
        echo -e "${YELLOW}[!] DHCP failed, trying static IP...${NC}"
        ip addr add 192.168.47.$((RANDOM % 200 + 50))/24 dev $INTERFACE 2>/dev/null
        CURRENT_IP=$(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
    fi
    
    echo -e "${GREEN}[✓] New IP: $CURRENT_IP${NC}"
}

one_shot() {
    echo -e "${BLUE}[*] One Shot Mode - Changing once${NC}"
    change_mac
    change_ip
    
    if [[ "$MODE_CHOICE" == "1" ]] || [[ "$MODE_CHOICE" == "3" ]]; then
        setup_tor
        change_location
    fi
    
    echo -e "\n${GREEN}[✓] Changes applied${NC}"
    echo -e "MAC: $(cat /sys/class/net/$INTERFACE/address 2>/dev/null)"
    echo -e "IP: $(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)"
    
    echo -e "\n${YELLOW}Run './ip-mac-pro --stop' to restore original settings${NC}"
    exit 0
}

continuous_mode() {
    local INTERVAL=$1
    local COUNTER=0
    
    while true; do
        COUNTER=$((COUNTER + 1))
        echo ""
        echo -e "${PURPLE}════════════════════════════${NC}"
        echo -e "${CYAN}[🌀] Cycle #${COUNTER}${NC}"
        echo -e "${PURPLE}════════════════════════════${NC}"
        
        if [[ "$MODE_CHOICE" == "1" ]] || [[ "$MODE_CHOICE" == "2" ]]; then
            change_mac
            sleep 1
            change_ip
        fi
        
        if [[ "$MODE_CHOICE" == "1" ]] || [[ "$MODE_CHOICE" == "3" ]]; then
            if [ "$COUNTER" -eq 1 ]; then
                setup_tor
            fi
            change_location
        fi
        
        echo -e "\n${YELLOW}[⏰] Next change in ${INTERVAL} seconds${NC}"
        sleep $INTERVAL
    done
}

if [[ "$1" == "--stop" ]] || [[ "$1" == "-s" ]]; then
    INTERFACE=$(ip route | grep default | awk '{print $5}' | head -1)
    ORIGINAL_MAC=$(cat /sys/class/net/$INTERFACE/address 2>/dev/null)
    stop_all
fi

show_banner

INTERFACE=$(ip route | grep default | awk '{print $5}' | head -1)
[ -z "$INTERFACE" ] && INTERFACE=$(ip link show | grep -v lo | grep "state UP" | head -1 | cut -d: -f2 | xargs)

ORIGINAL_MAC=$(cat /sys/class/net/$INTERFACE/address 2>/dev/null)
ORIGINAL_IP=$(ip -4 addr show $INTERFACE 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)

echo -e "${CYAN}[i] Interface: ${GREEN}$INTERFACE${NC}"
echo -e "${CYAN}[i] Original MAC: ${GREEN}$ORIGINAL_MAC${NC}"
echo -e "${CYAN}[i] Original IP: ${GREEN}$ORIGINAL_IP${NC}"
echo ""

echo -e "${YELLOW}════════════════════════════════════════════${NC}"
echo -e "${YELLOW}              SELECT MODE                     ${NC}"
echo -e "${YELLOW}════════════════════════════════════════════${NC}"
echo ""
echo -e "${CYAN}    1) ${GREEN}Full Anonymizer${NC}     - IP + MAC + Location"
echo -e "${CYAN}    2) ${GREEN}IP & MAC Only${NC}        - Just IP and MAC"
echo -e "${CYAN}    3) ${GREEN}Location Only${NC}        - Just Tor location"
echo -e "${CYAN}    4) ${GREEN}One Shot${NC}             - Change once"
echo -e "${CYAN}    5) ${RED}STOP${NC}                   - Stop all services"
echo ""

read -p "$(echo -e ${CYAN}[?] Choice [1-5]: ${NC})" MODE_CHOICE

if [[ "$MODE_CHOICE" == "5" ]]; then
    stop_all
fi

if [[ "$MODE_CHOICE" != "4" ]]; then
    echo ""
    echo -e "${YELLOW}════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}              SELECT INTERVAL                 ${NC}"
    echo -e "${YELLOW}════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${CYAN}    1) ${GREEN}30 seconds${NC}"
    echo -e "${CYAN}    2) ${GREEN}60 seconds${NC}  ${YELLOW}(Recommended)${NC}"
    echo -e "${CYAN}    3) ${GREEN}300 seconds${NC}"
    echo -e "${CYAN}    4) ${GREEN}Custom${NC}"
    echo ""

    read -p "$(echo -e ${CYAN}[?] Choice [1-4]: ${NC})" INT_CHOICE

    case $INT_CHOICE in
        1) INTERVAL=30 ;;
        2) INTERVAL=60 ;;
        3) INTERVAL=300 ;;
        4) read -p "$(echo -e ${CYAN}[?] Seconds: ${NC})" INTERVAL
           [[ ! "$INTERVAL" =~ ^[0-9]+$ ]] && INTERVAL=60 ;;
        *) INTERVAL=60 ;;
    esac
fi

case $MODE_CHOICE in
    1)  echo -e "${GREEN}[✓] Full Anonymizer - Every ${INTERVAL}s${NC}"
        sleep 1
        continuous_mode $INTERVAL
        ;;
    2)  echo -e "${GREEN}[✓] IP & MAC Only - Every ${INTERVAL}s${NC}"
        sleep 1
        continuous_mode $INTERVAL
        ;;
    3)  echo -e "${GREEN}[✓] Location Only - Every ${INTERVAL}s${NC}"
        sleep 1
        continuous_mode $INTERVAL
        ;;
    4)  one_shot
        ;;
    *)  echo -e "${RED}[!] Invalid${NC}"
        exit 1
        ;;
esac
