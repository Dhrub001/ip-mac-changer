#!/usr/bin/env bash
# ip-mac-pro - rotate your MAC address, DHCP lease and Tor identity.
# Author: Dhrub Raj Giri (DRG)  https://github.com/Dhrub001

DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck source=lib.sh
. "$DIR/lib.sh" || { echo "Cannot load lib.sh from $DIR" >&2; exit 1; }

IFACE=""
MODE=""
INTERVAL=""
STATUS=0
FROM_MENU=0
TOR_STARTED=0
TOR_READY=0
NETID_CHANGED=0
NETID_NOTE_SHOWN=0
TOR_NOTE_SHOWN=0

usage() {
    cat <<EOF
Usage: sudo ./ip-mac-pro [options]

With no options, a menu asks what to do.

Options:
  -m, --mode MODE     full   MAC + IP + Tor identity, repeated
                      netid  MAC + IP only, repeated
                      tor    Tor identity only, repeated
                      once   change everything one time and exit
  -t, --interval SEC  seconds between changes (minimum $IMC_MIN_INTERVAL, default 60)
  -i, --iface NAME    network interface (default: the one with the default route)
  -s, --stop          restore the original MAC, stop Tor and exit
      --status        show the current MAC, IP and Tor state (no root needed)
  -V, --version       show the version
  -h, --help          show this help
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        -m | --mode | -t | --interval | -i | --iface)
            [ $# -ge 2 ] || die "Option $1 needs a value"
            case $1 in
                -m | --mode) MODE=$2 ;;
                -t | --interval) INTERVAL=$2 ;;
                *) IFACE=$2 ;;
            esac
            shift 2 ;;
        -s | --stop) exec "$DIR/stop.sh" ;;
        --status) STATUS=1; shift ;;
        -V | --version) echo "ip-mac-changer $IMC_VERSION"; exit 0 ;;
        -h | --help) usage; exit 0 ;;
        *) err "Unknown option: $1"; usage >&2; exit 2 ;;
    esac
done

case $MODE in
    "" | full | netid | tor | once) ;;
    *) die "Unknown mode: $MODE (use full, netid, tor or once)" ;;
esac
if [ -n "$INTERVAL" ] && ! valid_interval "$INTERVAL"; then
    die "The interval must be a whole number of seconds, $IMC_MIN_INTERVAL or more"
fi

need_cmds ip awk sed
IFACE=$(detect_iface "$IFACE") || die "Network interface not found. List them with: ip link"

# ---------------------------------------------------------------- status
show_status() {
    local orig out
    orig=$(original_mac "$IFACE")
    printf '%-14s %s\n' "Interface" "$IFACE"
    printf '%-14s %s\n' "MAC now" "$(iface_mac "$IFACE")"
    printf '%-14s %s\n' "MAC original" "${orig:-unknown}"
    printf '%-14s %s\n' "Local IP" "$(iface_ip "$IFACE")"
    if command -v curl >/dev/null 2>&1; then
        printf '%-14s %s\n' "Public IP" "$(public_ip) (direct, without Tor)"
        if socks_up; then
            if out=$(tor_check); then
                printf '%-14s %s (check.torproject.org says IsTor=%s)\n' "Tor exit IP" "${out#* }" "${out%% *}"
            else
                printf '%-14s %s\n' "Tor" "proxy is up but not connected yet"
            fi
        else
            printf '%-14s %s\n' "Tor" "not running"
        fi
    fi
}

if [ "$STATUS" = 1 ]; then show_status; exit 0; fi

# ---------------------------------------------------------------- menu
choose_mode() {
    local c
    echo
    echo "What do you want to do?"
    echo "  1) Full      MAC + IP + Tor identity, repeated"
    echo "  2) IP & MAC  MAC + IP only, repeated"
    echo "  3) Tor only  Tor identity only, repeated"
    echo "  4) One shot  change once and exit"
    echo "  5) Stop      restore the original settings"
    read -r -p "Choice [1-5]: " c
    case $c in
        1) MODE=full ;;
        2) MODE=netid ;;
        3) MODE=tor ;;
        4) MODE=once ;;
        5) exec "$DIR/stop.sh" ;;
        *) die "Invalid choice" ;;
    esac
    FROM_MENU=1
}

choose_interval() {
    local c
    echo
    echo "Seconds between changes:"
    echo "  1) 30"
    echo "  2) 60 (recommended)"
    echo "  3) 300"
    echo "  4) Custom"
    read -r -p "Choice [1-4]: " c
    case $c in
        1) INTERVAL=30 ;;
        3) INTERVAL=300 ;;
        4) read -r -p "Seconds (minimum $IMC_MIN_INTERVAL): " INTERVAL ;;
        *) INTERVAL=60 ;;
    esac
    valid_interval "$INTERVAL" || die "The interval must be a whole number of seconds, $IMC_MIN_INTERVAL or more"
}

# ---------------------------------------------------------------- the changes
rotate_netid() {
    local old_mac old_ip new_mac new_ip
    old_mac=$(iface_mac "$IFACE")
    old_ip=$(iface_ip "$IFACE")
    save_original_mac "$IFACE" || { err "Could not save the original MAC, so I will not change it"; return 1; }
    NETID_CHANGED=1
    new_mac=$(random_mac)
    info "Changing the MAC on $IFACE"
    set_mac "$IFACE" "$new_mac" || return 1
    ok "MAC $old_mac -> $new_mac"
    info "Renewing the IP address"
    renew_ip "$IFACE" || return 1
    new_ip=$(iface_ip "$IFACE")
    if [ "$new_ip" = "$old_ip" ]; then
        ok "IP  $new_ip (the DHCP server handed out the same address, which is common)"
    else
        ok "IP  ${old_ip:-none} -> $new_ip"
    fi
    if [ "$NETID_NOTE_SHOWN" = 0 ]; then
        NETID_NOTE_SHOWN=1
        info "This changes your local address. Your public IP is set by your ISP or router and may not change."
    fi
}

rotate_tor() {
    local old new where
    if ! socks_up; then
        info "Starting Tor"
        tor_start || return 1
        TOR_STARTED=1
    fi
    if [ "$TOR_READY" != 1 ]; then
        info "Waiting for Tor to connect (this can take up to a minute)"
        tor_wait_ready 20 || { err "Tor could not connect. Check: systemctl status tor"; return 1; }
        TOR_READY=1
    fi
    old=$(tor_exit_ip)
    if tor_newnym; then
        nap "${IMC_SETTLE:-5}"
    else
        warn "Could not use Tor's control port, so I am restarting Tor instead. Run 'sudo ./install.sh' once to enable it."
        systemctl restart tor >/dev/null 2>&1 || { err "Could not restart Tor"; return 1; }
        tor_wait_ready 20 || { err "Tor did not come back. Check: systemctl status tor"; return 1; }
    fi
    new=$(tor_exit_ip)
    [ -n "$new" ] || { err "Could not read the Tor exit address"; return 1; }
    where=$(tor_where "$new")
    if [ "$new" = "$old" ]; then
        ok "Tor exit $new${where:+ ($where)} (the same exit as before, Tor sometimes reuses one)"
    else
        ok "Tor exit ${old:-unknown} -> $new${where:+ ($where)}"
    fi
    if [ "$TOR_NOTE_SHOWN" = 0 ]; then
        TOR_NOTE_SHOWN=1
        info "Only traffic sent through Tor's proxy ($TOR_SOCKS_HOST:$TOR_SOCKS_PORT) uses this exit: Tor Browser, torsocks, proxychains, or a browser set to that proxy. Normal traffic still leaves from your real connection."
    fi
}

one_shot() {
    local rc=0
    rotate_netid || rc=1
    if tor_installed && command -v curl >/dev/null 2>&1 && command -v nc >/dev/null 2>&1; then
        rotate_tor || rc=1
    else
        info "Skipping Tor (not installed). Run 'sudo ./install.sh' to add it."
    fi
    echo
    if [ "$rc" -eq 0 ]; then
        ok "Done. Run 'sudo ./stop.sh' to restore your original settings."
    else
        warn "Finished with errors (see above). Run 'sudo ./stop.sh' to restore your original settings."
    fi
    exit "$rc"
}

run_loop() {
    local n=0
    while true; do
        n=$((n + 1))
        printf '\n%s--- Cycle %d ---%s\n' "$C_BOLD" "$n" "$C_OFF"
        case $MODE in
            full | netid) rotate_netid || warn "The network change failed. Trying again next cycle." ;;
        esac
        case $MODE in
            full | tor) rotate_tor || warn "The Tor change failed. Trying again next cycle." ;;
        esac
        info "Next change in ${INTERVAL}s. Press Ctrl+C to stop and restore."
        nap "$INTERVAL"
    done
}

cleanup() {
    trap - INT TERM
    echo
    warn "Stopping. Restoring your original settings..."
    if [ "$NETID_CHANGED" = 1 ]; then restore_netid "$IFACE"; fi
    if [ "$TOR_STARTED" = 1 ]; then tor_stop; ok "Tor stopped"; fi
    exit 0
}

acquire_lock() {
    if ! mkdir -p "$IMC_STATE_DIR" || ! chmod 700 "$IMC_STATE_DIR"; then
        die "Cannot create $IMC_STATE_DIR"
    fi
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$IMC_STATE_DIR/lock"
        flock -n 9 || die "Another ip-mac-pro is already running. Stop it with: sudo ./stop.sh"
    fi
    echo $$ > "$IMC_STATE_DIR/pid"
    trap 'rm -f "$IMC_STATE_DIR/pid"' EXIT
}

# ---------------------------------------------------------------- main
if [ -z "$MODE" ]; then
    [ -t 0 ] || die "No mode given. Use --mode full|netid|tor|once, or run it in a terminal for the menu."
    printf '%sIP, MAC and Tor identity changer v%s%s  (by Dhrub Raj Giri)\n' "$C_BOLD" "$IMC_VERSION" "$C_OFF"
    info "Interface: $IFACE   MAC: $(iface_mac "$IFACE")   IP: $(iface_ip "$IFACE")"
    choose_mode
fi

need_root
case $MODE in
    full | tor) need_cmds curl nc pgrep ;;
esac
case $MODE in
    full | netid | tor)
        if [ -z "$INTERVAL" ]; then
            if [ "$FROM_MENU" = 1 ]; then choose_interval; else INTERVAL=60; fi
        fi ;;
esac

acquire_lock
trap cleanup INT TERM
[ "$FROM_MENU" = 1 ] || info "Interface: $IFACE   MAC: $(iface_mac "$IFACE")   IP: $(iface_ip "$IFACE")"

if [ "$MODE" = once ]; then one_shot; fi
info "Mode: $MODE, every ${INTERVAL}s"
run_loop
