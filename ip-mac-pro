    clear
    echo -e "${PURPLE}"
    echo "╔═══════════════════════════════════════════════════════════╗"
    echo "║                                                           ║"
    echo "║   ██▓ ██▓███   ▄▄▄      ▄▄▄█████▓ ▄████▄   ██░ ██ ▄▄▄     ║"
